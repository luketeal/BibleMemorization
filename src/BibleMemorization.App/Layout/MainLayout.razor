@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        @* The readiness marker the E2E suite waits on before every assertion. It sits
           here because this element wraps the routed page: it renders on every route
           and cannot exist until Blazor has started, which is exactly what the marker
           claims. *@
        <article class="content px-4" data-testid="app-ready">
            @Body
        </article>
    </main>
</div>
