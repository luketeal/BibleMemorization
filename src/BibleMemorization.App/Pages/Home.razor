@page "/"

<PageTitle>Bible Memorization</PageTitle>

<h1 data-testid="home-heading">Bible Memorization</h1>

<p class="lead">
    Learn passages by heart using techniques that gradually take the words away.
</p>

<div class="home-grid">
    <div class="home-card">
        <h2>Import</h2>
        <p>Pull a passage from a free Bible API by reference or by browsing books and chapters.</p>
    </div>
    <div class="home-card">
        <h2>Compose</h2>
        <p>Write your own text to memorize, or dictate it with your voice.</p>
    </div>
    <div class="home-card">
        <h2>Practice</h2>
        <p>Hide words one at a time, then test yourself by typing or speaking.</p>
    </div>
</div>
